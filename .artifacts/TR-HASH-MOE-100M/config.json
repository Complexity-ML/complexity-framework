{
  "architectures": [
    "DeepForCausalLM"
  ],
  "model_type": "deep",
  "hidden_size": 384,
  "num_hidden_layers": 10,
  "num_attention_heads": 8,
  "num_key_value_heads": 2,
  "intermediate_size": 128,
  "vocab_size": 200019,
  "max_position_embeddings": 2048,
  "attention_type": "gqa",
  "use_qk_norm": true,
  "rope_theta": 10000.0,
  "mlp_type": "token_routed",
  "num_experts": 4,
  "shared_expert": true,
  "shared_intermediate_size": 1520,
  "use_shared_routed_gates": false,
  "shared_gate_init": 1.0,
  "routed_gate_init": 0.1,
  "shared_output_scale": 1.0,
  "routed_output_scale": 2.0,
  "top_k": 2,
  "top_k_primary_weight": 0.5,
  "routing_strategy": "token_id_balanced_hash",
  "learn_hash_channel_modulation": true,
  "hash_channel_scale_init": 0.0,
  "use_mu_guidance": false,
  "disable_mu_guidance": true,
  "norm_type": "rmsnorm",
  "norm_eps": 1e-06,
  "rms_norm_eps": 1e-06,
  "tie_word_embeddings": true,
  "torch_dtype": "bfloat16"
}
