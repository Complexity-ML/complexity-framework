  "excluded_sources": {
    "context_qa_hotpot": "Long evidence prompts were heavily truncated and contain quote-template artifacts.",
    "dolci_sciriff": "Many label-only or very short completions; low value for assistant behavior.",
    "paradocs": "Parallel-document turns look multi-turn structurally but do not teach conversational memory.",
    "nemotron_code": "The 512-token run retained only 6.4% of sampled completions on average; replaced by execution-filtered code.",
    "nemotron_math_v2": "Long traces were truncated in the prior run; replaced by verified OpenR1 traces that fit completely.",
    "nemotron_instruction_following_chat_v1": "Sampled conversations remained too long even at 2048; replaced by short everyday conversations."
  },
  "quality_policy": {
    "min_assistant_chars": 16,
    "reject_refusals": true,
    "reject_repeated_lines": true,
    "reject_template_artifacts": true,
    "strip_empty_think_tags": true,
    "reject_any_token_truncation": true,
    "deduplicate_exact_conversations": true
  }
}
